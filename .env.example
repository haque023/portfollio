# Copy to `.env` for local development. For GitHub Pages, set these as
# repository *Variables* (Settings > Secrets and variables > Actions > Variables).
# None of these are secrets - they end up in the public bundle by design.

# Public origin of the deployed site (no trailing slash). Used for canonical URL,
# Open Graph, sitemap.xml, robots.txt and JSON-LD. Leave unset to omit those URLs.
VITE_SITE_URL=https://yourdomain.com

# Base path the site is served from.
#   Custom domain or USERNAME.github.io repo : /
#   https://USERNAME.github.io/REPOSITORY/   : /REPOSITORY/
VITE_BASE_PATH=/

# Social links. Leave blank to hide the matching buttons.
VITE_GITHUB_USERNAME=yourusername
VITE_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
